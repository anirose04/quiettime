      { "name": "Journal of Experimental Psychology: Learning, Memory, and Cognition", "issn": "0278-7393" },
      { "name": "Cognitive Research: Principles and Implications", "issn": "2365-7464" },
      { "name": "Journal of Cognition", "issn": "2514-4820" },
      { "name": "Open Mind", "issn": "2470-2986" },
      { "name": "Judgment and Decision Making", "issn": "1930-2975" },
